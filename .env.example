# Run commands from the repository root. Relative paths use that directory.
SLEEPSCAPE_TIMEZONE=Asia/Shanghai
SLEEPSCAPE_HOST=127.0.0.1
SLEEPSCAPE_PORT=8000
SLEEPSCAPE_DATA_DIR=./data

# No password file: loopback clients and local hostnames only.
# For a private HTTPS deployment, run `sleepscape web-password` first.
# SLEEPSCAPE_WEB_AUTH_FILE=.secrets/dashboard-auth.json
# SLEEPSCAPE_WEB_ALLOWED_HOSTS=["localhost","127.0.0.1","sleep.example.com"]
SLEEPSCAPE_DEBUG_API_DOCS=false

# Opt in only after explicit device registration and HTTPS deployment.
SLEEPSCAPE_ENVIRONMENT_INGEST_ENABLED=false

# China-region Garmin account; do not change regions automatically.
GARMIN_PERSONAL_API_BASE_URL=https://personal.connectapi.garmin.cn

# Local credential paths passed to the official SDK.
# These are paths, not credentials. Never place real keys in this template.
SLEEPSCAPE_GARMIN_KEY_FILE=./.secrets/garmin-personal-api-key
SLEEPSCAPE_GARMIN_TOKEN_CACHE=./.secrets/garmin-personal-api-bearer-token.json
