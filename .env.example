# Run commands from the repository root. Relative paths use that directory.
SLEEPSCAPE_TIMEZONE=Asia/Shanghai
SLEEPSCAPE_HOST=127.0.0.1
SLEEPSCAPE_PORT=8000
SLEEPSCAPE_DATA_DIR=./data

# No password file: loopback clients and local hostnames only.
# For a private HTTPS deployment, run `sleepscape web-password` first.
# SLEEPSCAPE_WEB_AUTH_FILE=.secrets/dashboard-auth.json
# SLEEPSCAPE_WEB_ALLOWED_HOSTS=["localhost","127.0.0.1","sleep.example.com"]
SLEEPSCAPE_DEBUG_API_DOCS=false
# Optional first wake-up date shown by the dashboard; unset keeps all history.
# Does not alter collection, stored history, load baselines, or environment UTC windows.
# SLEEPSCAPE_DASHBOARD_START_DATE=2026-11-18

# Opt in only after explicit device registration and HTTPS deployment.
SLEEPSCAPE_ENVIRONMENT_INGEST_ENABLED=false

# Model calls and automatic sleep reports are disabled by default.
# Keep URLs and credentials in local configuration, never in frontend code.
SLEEPSCAPE_LLM_ENABLED=false
SLEEPSCAPE_LLM_AUTOMATIC_ENABLED=false
SLEEPSCAPE_LLM_REVIEW_ENABLED=false
SLEEPSCAPE_LLM_MODEL_REF=sleep_analyst
SLEEPSCAPE_LLM_CONFIG_FILE=configs/models.toml
SLEEPSCAPE_LLM_KEY_FILE=.secrets/sleep-llm-key
# SLEEPSCAPE_LLM_BASE_URL=https://your-provider.example/compatible-mode/v1
# Or set a full HTTPS /chat/completions endpoint; never set both.
# SLEEPSCAPE_LLM_ENDPOINT=https://your-provider.example/compatible-mode/v1/chat/completions

# China-region Garmin account; do not change regions automatically.
GARMIN_PERSONAL_API_BASE_URL=https://personal.connectapi.garmin.cn
# Daily orchestration: strict sleep-source date window including today (1..31).
# Background exercise-load history is independent of this window.
SLEEPSCAPE_GARMIN_LOOKBACK_DAYS=7

# Local credential paths passed to the official SDK.
# These are paths, not credentials. Never place real keys in this template.
SLEEPSCAPE_GARMIN_KEY_FILE=./.secrets/garmin-personal-api-key
SLEEPSCAPE_GARMIN_TOKEN_CACHE=./.secrets/garmin-personal-api-bearer-token.json

# Automatic maintenance: enable the reviewed 04:00 systemd template on the server.
# Only verified, registered managed bundles are eligible for automatic retention.
SLEEPSCAPE_MAINTENANCE_KEEP_COUNT=3
SLEEPSCAPE_MAINTENANCE_MAX_BYTES=4294967296
# No external transfer until a destination is explicitly configured.
SLEEPSCAPE_MAINTENANCE_EXPORT_MODE=disabled
SLEEPSCAPE_MAINTENANCE_EXPORT_MAX_BYTES=17179869184
SLEEPSCAPE_MAINTENANCE_EXPORT_DAILY_KEEP=7
SLEEPSCAPE_MAINTENANCE_EXPORT_WEEKLY_KEEP=4
SLEEPSCAPE_MAINTENANCE_EXPORT_TIMEOUT_SECONDS=300
# path: existing private mounted destination; location/encryption must be verified separately.
# SLEEPSCAPE_MAINTENANCE_EXPORT_MODE=path
# SLEEPSCAPE_MAINTENANCE_EXPORT_PATH=/mnt/private-backups
# ssh: remote Python 3 and OpenSSH required; strict host verification, no interactive passwords.
# SLEEPSCAPE_MAINTENANCE_EXPORT_MODE=ssh
# SLEEPSCAPE_MAINTENANCE_EXPORT_PATH=/srv/private-backups
# SLEEPSCAPE_MAINTENANCE_EXPORT_HOST=backup.example.invalid
# SLEEPSCAPE_MAINTENANCE_EXPORT_USER=sleepscape-backup
# SLEEPSCAPE_MAINTENANCE_EXPORT_PORT=22
# SLEEPSCAPE_MAINTENANCE_EXPORT_IDENTITY_FILE=.secrets/backup-ssh-key
# SLEEPSCAPE_MAINTENANCE_EXPORT_KNOWN_HOSTS_FILE=.secrets/backup-known-hosts
