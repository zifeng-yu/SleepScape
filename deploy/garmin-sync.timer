# Template only: this repository does not install or enable timers.
[Unit]
Description=SleepScape Garmin sync daily at 09:00 Shanghai time

[Timer]
OnCalendar=*-*-* 09:00:00 Asia/Shanghai
# Catch up one missed timer activation; garmin-sync determines the history window.
Persistent=true
AccuracySec=1min
Unit=garmin-sync.service

[Install]
WantedBy=timers.target
